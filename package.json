{
  "name": "dental-office-fe",
  "version": "0.0.0",
  "main": "main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration=production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "electron": "ng build --configuration production && electron .",
    "dist": "npm run electron && electron-builder",
    "build-fe": "ng build --configuration=production",
    "serve-fe": "lite-server --baseDir=\"dist/DentalOffice-FE/browser\" --browser=chrome",
    "build-be": "cd ../DentalOffice-BE && dotnet build DentalOffice-BE.sln",
    "run-be": "cd ../DentalOffice-BE && dotnet run --project DentalOffice-BE/DentalOffice-BE.csproj --urls=http://localhost:7020",
    "start-easy": "concurrently \"npm run serve-fe\" \"npm run build-be && npm run run-be\""
  },
  "build": {
      "appId": "dentaloffice-fe", 
      "productName": "Dental Office", 
      "files": [
        "dist/**/*", 
        "main.js"
      ],
      "directories": {
        "output": "release" 
      },
      "win": {
        "target": "nsis", 
        "icon": "path/to/icon.ico" 
      },
      "mac": {
        "target": "dmg", 
        "icon": "path/to/icon.icns" 
      }
  },
  "private": true,
  "dependencies": {
    "@angular-material-components/color-picker": "^16.0.1",
    "@angular/animations": "^17.1.0",
    "@angular/cdk": "^17.0.4",
    "@angular/common": "^17.0.0",
    "@angular/compiler": "^17.0.0",
    "@angular/core": "^17.0.0",
    "@angular/forms": "^17.0.9",
    "@angular/material": "^17.0.4",
    "@angular/platform-browser": "^17.0.0",
    "@angular/platform-browser-dynamic": "^17.0.0",
    "@angular/router": "^17.0.0",
    "@ngstack/code-editor": "^9.0.0",
    "@ngx-formly/core": "^6.2.2",
    "@ngx-formly/material": "^6.2.2",
    "@pdfme/common": "^4.4.1",
    "@pdfme/generator": "^4.3.2",
    "@pdfme/ui": "^4.4.1",
    "ag-grid-angular": "^31.0.1",
    "bootstrap": "^5.3.2",
    "bootstrap-icons": "^1.11.3",
    "concurrently": "^9.2.0",
    "electron": "^28.1.1",
    "html2canvas": "^1.4.1",
    "html2pdf-ts": "^1.1.1",
    "jspdf": "^2.5.1",
    "material-icons": "^1.13.12",
    "moment": "^2.30.1",
    "ng2-pdf-viewer": "^10.0.0",
    "ngx-colors": "^3.5.3",
    "pdfmake": "^0.2.10",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.0.9",
    "@angular/cli": "^17.0.9",
    "@angular/compiler-cli": "^17.0.0",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.11.4",
    "@types/pdfmake": "^0.2.9",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.2.2"
  }
}
